<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="9dp"
    android:paddingRight="10dp"
    android:paddingBottom="9dp">

    <!-- Top Bar: Lab Name & Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Lab Name -->
        <TextView
            android:id="@+id/widget_lab_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Lab Wizard"
            android:textColor="#1A1917"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Quick Actions Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_widget_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_button_bg"
                android:paddingLeft="7dp"
                android:paddingTop="3dp"
                android:paddingRight="7dp"
                android:paddingBottom="3dp"
                android:text="📷 Scan"
                android:textColor="#1A1917"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_button_bg"
                android:paddingLeft="6dp"
                android:paddingTop="3dp"
                android:paddingRight="6dp"
                android:paddingBottom="3dp"
                android:text="🔍 Search"
                android:textColor="#1A1917"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_button_bg"
                android:paddingLeft="6dp"
                android:paddingTop="3dp"
                android:paddingRight="6dp"
                android:paddingBottom="3dp"
                android:text="↩ Undo"
                android:textColor="#1A1917"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider Line -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="#E5DFC9"
        android:contentDescription="Divider" />

    <!-- Main Content Area: Feed on Left + Continuous Animated Flaskie on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Today's Consumption Feed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="64"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_today_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S CONSUMPTION"
                android:textColor="#6A665E"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <!-- Empty State Prompt -->
            <LinearLayout
                android:id="@+id/widget_empty_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Benchtop ready for work"
                    android:textColor="#1A1917"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="No consumption logged today yet."
                    android:textColor="#6A665E"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Tap [📷 Scan] above to record usage."
                    android:textColor="#3F6F3B"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Items List Container -->
            <LinearLayout
                android:id="@+id/widget_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:id="@+id/widget_item_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:layout_marginBottom="1.5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_item_1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Ethanol 99.8%"
                        android:textColor="#1A1917"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_1_used"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginStart="4dp"
                        android:text="-150 mL"
                        android:textColor="#B86B14"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_1_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginStart="4dp"
                        android:text="(1.2L left)"
                        android:textColor="#6A665E"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:id="@+id/widget_item_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:layout_marginBottom="1.5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_item_2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Acetone"
                        android:textColor="#1A1917"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_2_used"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginStart="4dp"
                        android:text="-25 mL"
                        android:textColor="#B86B14"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_2_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginStart="4dp"
                        android:text="(375mL left)"
                        android:textColor="#6A665E"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:id="@+id/widget_item_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:layout_marginBottom="1.5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_item_3_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Beaker 250mL"
                        android:textColor="#1A1917"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_3_used"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginStart="4dp"
                        android:text="-2 pcs"
                        android:textColor="#B86B14"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_3_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginStart="4dp"
                        android:text="(13 pcs left)"
                        android:textColor="#6A665E"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Quick Inventory Count -->
            <TextView
                android:id="@+id/widget_stock_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="24 chems • 18 apparatus"
                android:textColor="#8C867A"
                android:textSize="8.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right: Animated Flaskie Buddy + Information Bubble -->
        <LinearLayout
            android:id="@+id/widget_flaskie_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="36"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Information Speech Bubble (1 info per click) -->
            <TextView
                android:id="@+id/widget_flaskie_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:background="@drawable/widget_speech_bubble"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingLeft="7dp"
                android:paddingTop="3dp"
                android:paddingRight="7dp"
                android:paddingBottom="3dp"
                android:text="Ready to experiment!"
                android:textColor="#1A1917"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Continuously Animated ViewFlipper (Frame 1 -> Frame 2 -> Frame 3 loop) -->
            <ViewFlipper
                android:id="@+id/widget_flaskie_flipper"
                android:layout_width="62dp"
                android:layout_height="68dp"
                android:autoStart="true"
                android:flipInterval="1100">

                <ImageView
                    android:id="@+id/widget_flaskie_frame_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Flaskie Resting" />

                <ImageView
                    android:id="@+id/widget_flaskie_frame_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Flaskie Blinking" />

                <ImageView
                    android:id="@+id/widget_flaskie_frame_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Flaskie Smiling" />
            </ViewFlipper>

            <!-- Tap Hint for Interactive Information Rotation -->
            <TextView
                android:id="@+id/widget_flaskie_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Tap for info 💬"
                android:textColor="#8C867A"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

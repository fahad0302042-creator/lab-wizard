<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Bar: Lab Name & Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Lab Name -->
        <TextView
            android:id="@+id/widget_lab_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Lab Wizard"
            android:textColor="@color/widget_text_ink"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- Quick Actions Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_widget_scan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3.5dp"
                android:text="📷 Scan"
                android:textColor="@color/widget_text_ink"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3.5dp"
                android:text="🔍 Search"
                android:textColor="@color/widget_text_ink"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3.5dp"
                android:text="↩ Undo"
                android:textColor="@color/widget_text_ink"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="@color/widget_divider" />

    <!-- Main Content Area: Feed on Left + Animated Flaskie on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Today's Consumption Feed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="68"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_today_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S CONSUMPTION"
                android:textColor="@color/widget_text_muted"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <!-- Empty State Prompt -->
            <TextView
                android:id="@+id/widget_empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="No consumption logged today.\nTap [📷 Scan] to log."
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Items List Container -->
            <LinearLayout
                android:id="@+id/widget_items_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:id="@+id/widget_item_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="1.5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_item_1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Ethanol 99.8%"
                        android:textColor="@color/widget_text_ink"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_1_used"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="-150 mL"
                        android:textColor="@color/widget_accent_amber"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_1_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="(1.2L left)"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:id="@+id/widget_item_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="1.5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_item_2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Acetone"
                        android:textColor="@color/widget_text_ink"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_2_used"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="-25 mL"
                        android:textColor="@color/widget_accent_amber"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_2_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="(375mL left)"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:id="@+id/widget_item_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="1.5dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_item_3_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Beaker 250mL"
                        android:textColor="@color/widget_text_ink"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_3_used"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="-2 pcs"
                        android:textColor="@color/widget_accent_amber"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_item_3_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="(13 pcs left)"
                        android:textColor="@color/widget_text_muted"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Right: Animated Flaskie Buddy + Speech Bubble -->
        <LinearLayout
            android:id="@+id/widget_flaskie_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="32"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Speech Bubble -->
            <TextView
                android:id="@+id/widget_flaskie_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:background="@drawable/widget_speech_bubble"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="3 used today!"
                android:textColor="@color/widget_text_ink"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Animated ViewFlipper (Cycles frames 1, 2, 3 smoothly in launcher) -->
            <ViewFlipper
                android:id="@+id/widget_flaskie_flipper"
                android:layout_width="52dp"
                android:layout_height="58dp"
                android:autoStart="true"
                android:flipInterval="1400">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Flaskie Resting"
                    android:src="@drawable/flaskie_frame_1" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Flaskie Blinking"
                    android:src="@drawable/flaskie_frame_2" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Flaskie Smiling"
                    android:src="@drawable/flaskie_frame_3" />
            </ViewFlipper>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
